# Copy to cloud/deploy/.env and generate unique values with openssl rand -hex 32.
CUNLIAN_API_KEY=
CUNLIAN_APPROVAL_SECRET=
# CUNLIAN_KEYS is an alternative JSON array with name,key,write,takeover,tools fields.
# CUNLIAN_KEYS=
FEATURE_3D_ASSEMBLY_M1=false
# CUNLIAN_PUBLIC_ORIGIN=https://cunlian.example.org
# Exact peer IP observed by Node. Set only when needed for proxy metadata.
# CUNLIAN_TRUSTED_PROXIES=
# Comma-separated, operator-controlled HTTPS endpoints. Exact URLs, no redirects.
# CUNLIAN_WEBHOOK_URLS=https://agent-gateway.example.org/confirm
# CUNLIAN_WEBHOOK_SECRET=
# CUNLIAN_MODEL_URLS=https://model-gateway.example.org/v1
# CUNLIAN_TIMEOUT_MS=30000
# CUNLIAN_LEASE_MS=900000
# CUNLIAN_CONFIRMATION_MS=120000
# CUNLIAN_MAX_UPLOAD=16777216
