                          "textSnippet": {"type":"string","minLength":1,"maxLength":4000},
                          "normalizedSnippet": {"type":"string","maxLength":4000},
                          "textItemIndexes": {"maxItems":64,"type":"array","items":{"type":"integer","minimum":0,"maximum":9007199254740991}},
                          "kind": {"type":"string","const":"pdf-text"}
                        },
