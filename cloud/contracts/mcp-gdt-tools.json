                          "page": {"type":"integer","minimum":1,"maximum":9007199254740991},
                          "rectPdf": {
                            "type": "array",
                            "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}],
                            "items": false,
                            "minItems": 4,
                            "maxItems": 4
                          },
                          "pageBoxPdf": {
                            "type": "array",
