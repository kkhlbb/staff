                          "documentId",
                          "revisionId",
                          "sha256",
                          "blobKey",
                          "page",
                          "rectPdf",
                          "pageBoxPdf",
                          "textSnippet",
                          "normalizedSnippet",
                          "textItemIndexes"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
