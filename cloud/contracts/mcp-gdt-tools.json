                        "datumModifiers": {"maxItems":2,"type":"array","items":{"type":"string","enum":["MMC","LMC","RFS"]}}
                      }
                    }
                  },
                  "required": ["id","featureId","kind","toleranceQ","datumIds"],
                  "additionalProperties": false,
                  "description": "Datum modifier count must not exceed the datum count. Upper size deviation must be at least the lower deviation. Composite lower tolerance cannot exceed the upper tolerance. Lower datums must be an ordered prefix, and lower modifiers require corresponding datums. Cylindricity requires a cylindrical feature. Runout requires an axis datum and resolves MMC/LMC to RFS with warnings.",
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {"enum":["flatness","cylindricity"]},
                        "datumIds": {"maxItems":0,"type":"array","items":{"type":"string","minLength":1,"maxLength":200}},
                        "lowerSegment": false
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {"enum":["position","perpendicularity","parallelism","coaxiality","circular-runout","total-runout"]},
                        "datumIds": {"maxItems":3,"type":"array","items":{"type":"string","minLength":1,"maxLength":200},"minItems":1},
                        "lowerSegment": false
                      }
