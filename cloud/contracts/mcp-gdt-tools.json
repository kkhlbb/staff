                                  "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
                                  "page": {"type":"integer","minimum":1,"maximum":9007199254740991}
                                },
                                "required": ["kind","revisionId","sha256","page"],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {"type":"string","const":"image"},
                                  "imageId": {"type":"string","minLength":1,"maxLength":240},
                                  "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
                                  "region": {
                                    "type": "object",
                                    "properties": {
                                      "index": {"type":"integer","minimum":1,"maximum":9007199254740991},
                                      "rect": {
                                        "anyOf": [
                                          {
                                            "type": "array",
                                            "prefixItems": [
                                              {"type":"integer","minimum":0,"maximum":9007199254740991},
                                              {"type":"integer","minimum":0,"maximum":9007199254740991},
                                              {"type":"integer","minimum":1,"maximum":9007199254740991},
                                              {"type":"integer","minimum":1,"maximum":9007199254740991}
                                            ],
                                            "items": false,
                                            "minItems": 4,
                                            "maxItems": 4
                                          },
                                          {"type":"null"}
                                        ]
                                      }
                                    },
                                    "required": ["index","rect"],
                                    "additionalProperties": false
                                  }
                                },
                                "required": ["kind","imageId","sha256"],
                                "additionalProperties": false
                              }
                            ]
                          }
                        },
                        "required": ["kind","actorId","at","sessionSeq","turnId","modelId","statement","source"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "documentId": {"type":"string","minLength":1,"maxLength":240},
