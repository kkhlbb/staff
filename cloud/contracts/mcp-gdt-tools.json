                          },
                          "sessionSeq": {"type":"integer","minimum":1,"maximum":9007199254740991},
                          "turnId": {"type":"string","minLength":1,"maxLength":240},
                          "modelId": {"anyOf":[{"type":"string","minLength":1,"maxLength":240},{"type":"null"}]},
