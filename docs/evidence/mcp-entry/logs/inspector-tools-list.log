{
  "tools": [
    {
      "name": "read_taskbook",
      "title": "读任务书 PDF（候选 + 阻塞项）",
      "description": "读本地带文本层 PDF 的指定页范围，输出候选（kind/符号/数值 q/单位/出处{页,选区,原文}）与阻塞项（原因码 + 人话）。只读：不写文件、不确认候选、不建项目。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pdfPath": {
            "type": "string",
            "description": "PDF 绝对路径（只支持文本层，不做 OCR）。"
          },
          "pageFrom": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "pageTo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "可选；缺省为 pageFrom 起最多 100 页（提取器单块上限，超过自动切块）。"
          }
        },
        "required": [
          "pdfPath"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calc_chain",
      "title": "计算线性尺寸链（极值法）",
      "description": "用与桌面端相同的确定性内核计算一维线性尺寸链：封闭环 C 的 q/ mm、极值上下限、公差与组成环清单。只读，不写任何文件。两种输入：parameters（隔套内径/外径/长度，q）或 terms（任意组成环数组，q）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "parameters": {
            "type": "object",
            "description": "隔套三参数（整数 q，1q = 0.0001 mm）。与 terms 二选一。",
            "additionalProperties": false,
            "properties": {
              "innerDiameterQ": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000000
              },
              "outerDiameterQ": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000000
              },
              "lengthQ": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000000
              }
            },
            "required": [
              "innerDiameterQ",
              "outerDiameterQ",
              "lengthQ"
            ]
          },
          "terms": {
            "type": "array",
            "description": "显式组成环（与 parameters 二选一）。sign=1 为增环，-1 为减环。",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "name": {
                  "type": "string",
                  "maxLength": 64
                },
                "nominalQ": {
                  "type": "integer",
                  "minimum": -10000000000,
                  "maximum": 10000000000
                },
                "lowerDeviationQ": {
                  "type": "integer",
                  "minimum": -10000000000,
                  "maximum": 10000000000
                },
                "upperDeviationQ": {
                  "type": "integer",
                  "minimum": -10000000000,
                  "maximum": 10000000000
                },
                "sign": {
                  "type": "integer",
                  "enum": [
                    1,
                    -1
                  ]
                }
              },
              "required": [
                "symbol",
                "nominalQ",
                "lowerDeviationQ",
                "upperDeviationQ",
                "sign"
              ]
            }
          },
          "formula": {
            "type": "string",
            "maxLength": 200,
            "description": "可选；仅用于输出说明。"
          },
          "assumptions": {
            "type": "string",
            "maxLength": 1000
          },
          "target": {
            "description": "可选目标区间；null 表示不判定。",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minQ": {
                    "type": "integer",
                    "minimum": -10000000000,
                    "maximum": 10000000000
                  },
                  "maxQ": {
                    "type": "integer",
                    "minimum": -10000000000,
                    "maximum": 10000000000
                  }
                },
                "required": [
                  "minQ",
                  "maxQ"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "check_requirement",
      "title": "按闭区间判定条款是否满足",
      "description": "把封闭环 C（整数 q）与任务书要求的闭区间比较：返回 satisfied / exceeded、下/上裕量（q + mm）与判定依据原因码。边界相等默认算满足；只读、不写文件。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cQ": {
            "type": "integer",
            "minimum": -10000000000,
            "maximum": 10000000000,
            "description": "封闭环 C 的（下）值，整数 q；1q = 0.0001 mm。"
          },
          "cMaxQ": {
            "type": "integer",
            "minimum": -10000000000,
            "maximum": 10000000000,
            "description": "可选：封闭环 C 的区间上限（极值法的 Cmax）。缺省时按单值点判定。"
          },
          "lowerQ": {
            "type": "integer",
            "minimum": -10000000000,
            "maximum": 10000000000,
            "description": "条款下限，整数 q。"
          },
          "upperQ": {
            "type": "integer",
            "minimum": -10000000000,
            "maximum": 10000000000,
            "description": "条款上限，整数 q。"
          },
          "inclusive": {
            "type": "boolean",
            "description": "是否含边界（闭区间）；默认 true。false 时边界相等算不满足。"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "description": "可选：条款原文或说明（仅回显）。"
          }
        },
        "required": [
          "cQ",
          "lowerQ",
          "upperQ"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "render_drawing",
      "title": "出图（SVG / DXF）",
      "description": "按隔套参数生成 A4 工程图 SVG 或 DXF（R12 / 2000），写入调用方指定的绝对目录，返回真实文件路径、字节数、SHA-256 与「用户输入，无外部原文件」依据标记。只新增导出文件，不写项目、不提交。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "innerDiameter": {
                "type": "string",
                "description": "内径，十进制 mm 字符串，最多 4 位小数"
              },
              "outerDiameter": {
                "type": "string",
                "description": "外径，十进制 mm 字符串，最多 4 位小数"
              },
              "length": {
                "type": "string",
                "description": "长度，十进制 mm 字符串，最多 4 位小数"
              }
            },
            "required": [
              "innerDiameter",
              "outerDiameter",
              "length"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "svg",
              "dxf"
            ]
          },
          "dxfVersion": {
            "type": "string",
            "enum": [
              "r12",
              "2000"
            ],
            "description": "format=dxf 时的版本；默认 2000。"
          },
          "outputDir": {
            "type": "string",
            "description": "输出目录的绝对路径（不存在则创建）。"
          }
        },
        "required": [
          "parameters",
          "format",
          "outputDir"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "describe_project",
      "title": "只读描述 .cunlian 项目",
      "description": ".cunlian（ZIP）绝对路径 → 正式版本、三参数、尺寸链组成环、活动条款、出处清单。只读：只解码与读取，不提交、不保存、不改任何字段。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": ".cunlian 项目文件绝对路径。"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  ]
}
