{
  "name": "staff",
  "private": true,
  "version": "0.5.3-beta",
  "license": "MIT",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.mcp.json --noEmit",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "preview": "vite preview",
    "start:desktop": "electron-forge start",
    "package:desktop": "node scripts/package-desktop.mjs",
    "check:package:pdf-worker": "node scripts/assert-packaged-pdf-worker.mjs",
    "make:desktop": "electron-forge make",
    "typecheck:desktop": "tsc -p tsconfig.desktop.json --noEmit",
    "test:desktop": "vitest run --config vitest.desktop.config.ts",
    "pretest:desktop": "node scripts/step-assets.mjs",
    "step:assets": "node scripts/step-assets.mjs",
    "test:step-kernel": "node scripts/step-assets.mjs && vitest run --config vitest.desktop.config.ts desktop/tests/stepKernel.test.ts",
    "check:package:step": "node scripts/assert-packaged-step.mjs",
    "check:release:step": "node scripts/check-step-release.mjs",
    "test:step-license": "node --test scripts/step-license.test.mjs",
    "test:real-docs": "vitest run --config vitest.realdocs.config.ts",
    "metrics:real-docs": "node scripts/real-doc-metrics.mjs",
    "test:desktop:e2e": "node desktop/tests/e2e/smoke.mjs",
    "test:desktop:layout": "node desktop/tests/e2e/layout.mjs",
    "evidence:record": "vitest run --config vitest.evidence.config.ts",
    "evidence:dxf": "vitest run --config vitest.dxfexport.config.ts",
    "test:desktop:dxf-e2e": "node desktop/tests/e2e/dxfExport.mjs",
    "artifact:export": "vitest run --config vitest.v40stage4export.config.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.24.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "replicad-opencascadejs": "1.2.1",
    "smol-toml": "1.9.1",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dxf-parser": "^1.1.2",
    "electron": "45.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
